# ─── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://agastahomeo.com

# WhatsApp: digits with country code, no "+". Used to build wa.me links.
NEXT_PUBLIC_WHATSAPP=9199XXXXXXXX
NEXT_PUBLIC_PHONE_DISPLAY=+91 99XXX XXXXX
NEXT_PUBLIC_PHONE_TEL=+9199XXXXXXXX

# Live Google Form URL for doctor applications — never the /edit URL.
# Built by app-doc/kanha/google-forms/create-agasta-homeo-doctor-form.gs
NEXT_PUBLIC_DOCTOR_FORM_URL=https://forms.gle/XXXXXXXX

# Printed in the footer once issued by MCA / GST.
# NEXT_PUBLIC_CIN=
# NEXT_PUBLIC_GST=

# ─── Patient leads → Google Sheets ─────────────────────────────────────────
# Sheet: "Agasta Homeo — Leads", tab "Patients", 9 columns (blueprint §5.2).
# Share it with named accounts only — never "anyone with the link".

# Option A — Apps Script webhook (fastest; what you deploy today)
# Deploy scripts/google-sheets-apps-script.gs as a Web app:
#   Execute as: Me · Who has access: Anyone
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEETS_SECRET=change-me-to-a-random-32-char-string

# Option B — service account (preferred once you have 10 spare minutes;
# no redirect handling, proper auth). Share the sheet with the service
# account email as Editor, then paste the whole JSON key on one line.
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
